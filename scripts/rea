#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export GHIDRA_INSTALL_DIR="$project_dir/tools/providers/ghidra_12.1.4_PUBLIC"
