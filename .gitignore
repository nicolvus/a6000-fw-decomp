# Firmware propietario de Sony (no se distribuye) y herramientas de terceros
firmware/
tools/downloads/
tools/providers/

# Entornos y cachés regenerables
.venv/
.venv-fwtool/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.knowledge-cache/
__pycache__/
*.pyc

# Proyectos Ghidra (bases binarias derivadas del firmware) y copias de trabajo del binario
analysis/ghidra/*.rep/
**/*.gbf
**/input/
work/*/input/
analysis/rea-independent/input/
*.bin
*.elf

# Desensamblados completos regenerables desde el firmware (no se distribuyen)
*.dis

# Archivos de terceros / instaladores
*.exe
*.dmg
*.tar.gz

# Manuales de servicio con copyright (no propios), en cualquier formato
references/manuals/*.pdf
references/manuals/*.txt
docs/references/sony-ilce-*.txt
sony_ilce*.pdf
sony_ilce*.txt

# Dependencias de terceros reinstalables
node_modules/

# Logs crudos de sesiones de agentes con volcados extensos (regenerables, muy grandes)
analysis/codex-logs/*.log

# S53: proyectos Ghidra y volcados completos de pseudocódigo derivados de las ROM Darwin (regenerables con analysis/s53/)
analysis/s53/ghidra/*.rep/
analysis/s53/ghidra/*.c
analysis/s53/ghidra/*.log

# Estado y logs de sesiones REA (sockets, puertos, respuestas)
analysis/rea-independent/run/
# Volcados de cámara: se versionan con README; fuera los binarios Sony (libs/odex/jar), los JPEG con EXIF y las series de RAM de 4 MiB (solo README y SHA256SUMS)
analysis/camera-dumps/pull-*/
analysis/camera-dumps/live-android-*/
analysis/camera-dumps/live-shots-*/
analysis/camera-dumps/silent-ram*/*.bin
analysis/camera-dumps/nand-*/*.bin
analysis/camera-dumps/full-*/*.bin
analysis/camera-dumps/ram-servicio-*/*.bin
analysis/camera-dumps/sfr-scan-*/scan_*.bin

# S66+: caches de barrido Capstone regenerables (analysis/s66/.cache = 126 MB)
.cache/
**/.cache/

# Demonios REA: logs, sockets y volcados de sesión (regenerables)
analysis/rea-independent/run/*.log
analysis/rea-independent/run/*.sock
analysis/rea-independent/run/*.sock.ready
analysis/rea-independent/run/*.out

# Volcados de cadenas/TSV regenerables de analyses puntuales
analysis/s65_video/strings_all.tsv

# Ejecutables/APK extraídos de la cámara (propiedad de Sony): solo README y manifiesto
analysis/camera-extract/*
!analysis/camera-extract/README.md
!analysis/camera-extract/manifest.json

