# Instalar: cp rea-avcam.service ~/.config/systemd/user/ && systemctl --user enable --now rea-avcam (rutas absolutas de esta máquina)
[Unit]
Description=REA av-cam.bin (sesión Ghidra caliente)
[Service]
Environment=REA_DAEMON_IDLE_S=0 REA_DAEMON_RSS_MAX_MB=5000
ExecStartPre=/bin/rm -f /home/nicolas/Documents/a6000/sony-a6000-electronic-shutter/analysis/rea-independent/out/av-cam.sock /home/nicolas/Documents/a6000/sony-a6000-electronic-shutter/analysis/rea-independent/out/av-cam.sock.ready
ExecStart=/usr/bin/python3 /home/nicolas/Documents/a6000/sony-a6000-electronic-shutter/analysis/rea-independent/bin/session_daemon.py /home/nicolas/Documents/a6000/sony-a6000-electronic-shutter/analysis/rea-independent/out/av-cam.sock '{"path":"/home/nicolas/Documents/a6000/sony-a6000-electronic-shutter/analysis/rea-independent/input/av-cam.bin","format":"raw-binary","architecture":"arm","entry_point":"0x43541000","provider_id":"ghidra"}'
Restart=on-failure
[Install]
WantedBy=default.target
