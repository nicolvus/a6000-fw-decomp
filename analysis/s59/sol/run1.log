new file mode 100644
index 0000000000000000000000000000000000000000..25d6c12ccfec8a526deafdd9aa172f0782926e01
--- /dev/null
+++ b/analysis/s59/sol/inspect_timing.py
@@ -0,0 +1,32 @@
+"""Búsqueda dirigida y contraste Capstone sobre av-cam A6000, sin modificarlo."""
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "analysis/s58"))
+from tdis import data, dis, ins_list
+
+
+def scan():
+    """Candidatos, no xrefs probadas: el barrido lineal puede atravesar datos."""
+    instructions = ins_list("A6000")
+    targets = {"#0x43ae84c0", "#0x437876dc"}
+    hits = []
+    for k, (address, mnemonic, operands) in enumerate(instructions):
+        if (mnemonic in ("bl", "b.w") and operands in targets) or (
+            "#0xdd0" in operands and mnemonic.startswith(("add", "str", "ldr"))
+        ):
+            hits.append({"address": hex(address), "context": [
+                f"{a:08x} {m} {o}" for a, m, o in instructions[max(0, k - 5):k + 9]
+            ]})
+    return hits
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 3:
+        dis("A6000", int(sys.argv[1], 0), int(sys.argv[2], 0))
+    else:
+        import hashlib
+        print(json.dumps({"sha256": hashlib.sha256(data("A6000")).hexdigest(),
+                          "candidate_hits": scan()}, indent=2))
diff --git a/analysis/s59/sol/maintain_knowledge.py b/analysis/s59/sol/maintain_knowledge.py
new file mode 100644
index 0000000000000000000000000000000000000000..40b55663d5316b30e9f406385d336d789aaaa407
--- /dev/null
+++ b/analysis/s59/sol/maintain_knowledge.py
@@ -0,0 +1,54 @@
+"""Mantenimiento aislado: respeta el alcance exclusivo de entregables S59/sol."""
+import sqlite3
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+sys.path.insert(0, str(ROOT / "scripts/knowledge"))
+from export_corrections import export_corrections, export_open_questions
+
+
+def main():
+    with tempfile.TemporaryDirectory(prefix="s59-sol-knowledge-") as directory:
+        db = Path(directory) / "knowledge.sqlite"
+        source = sqlite3.connect(
+            f"file:{ROOT / '.knowledge-cache/knowledge.sqlite'}?mode=ro", uri=True,
+        )
+        target = sqlite3.connect(db)
+        try:
+            source.backup(target)
+        finally:
+            source.close()
+            target.close()
+        totals = []
+        for step in ("index_docs.py", "build_graph.py", "export", "index_docs.py", "build_graph.py"):
+            if step == "export":
+                connection = sqlite3.connect(db)
+                try:
+                    a = export_corrections(connection, OUT / "knowledge-corrections.txt")
+                    b = export_open_questions(connection, OUT / "knowledge-open-questions.txt")
+                    print("exportaciones aisladas:", a, b, flush=True)
+                finally:
+                    connection.close()
+                continue
+            result = subprocess.run(
+                [str(ROOT / ".venv/bin/python"), str(ROOT / "scripts/knowledge" / step),
+                 "--db", str(db)], cwd=ROOT, capture_output=True, text=True, check=True,
+            )
+            print(step, result.stdout.strip(), flush=True)
+            if step == "build_graph.py":
+                connection = sqlite3.connect(db)
+                try:
+                    totals.append(connection.execute("SELECT count(*) FROM relations").fetchone()[0])
+                finally:
+                    connection.close()
+        if len(totals) != 2 or totals[0] != totals[1]:
+            raise RuntimeError(f"Grafo inestable: {totals}")
+        print("Estabilidad verificada:", totals, flush=True)
+
+
+if __name__ == "__main__":
+    main()
