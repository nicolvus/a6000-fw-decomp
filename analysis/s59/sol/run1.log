      T = rnd.choice([rnd.randrange(1 << 32), rnd.randrange(1 << 24), rnd.randrange(1 << 20) * 256]); clk = rnd.choice([0, 54_000_000, 72_000_000, 143_000_000])
      for fill in (0, 0xa5):
