+sys.path.insert(0, str(SOURCE.parent))
+code = SOURCE.read_text().replace(
+    'os.path.join(os.path.dirname(sock_path), "../out/exp2-session-log.jsonl")',
+    'os.path.join(os.path.dirname(sock_path), "rea-session.jsonl")',
+)
