+# Hipótesis S50 B (por resolver contra REA)
+
+| ID | Hipótesis comprobable | Prueba/discriminante | Evidencia contraria conocida |
+|---|---|---|---|
+| H1 | Clase 2 de SetExposure permite fin electrónico | Semántica de ID1 bits d4/94, IDs100/101, tiempo+3a0 y secuencia externa sin cierre | Ningún significado eléctrico de bits documentado; secuencia externa ordinaria solicita CAIF |
+| H2 | Una secuencia interna sin CAIF basta | Resolver fila externa + selector interno y guardas | S21: filas normales +a0..+118 pasan por Stage_CaComm |
+| H3 | cap+74f=0 permite omitir petición mecánica manteniendo foto | Cuerpo Stage_CaComm, productor/identidad de campo, efecto en estados | Puede ser estado de reintentos, cancelación o prerrequisito, no selector físico |
+| H4 | Fila externa+12c aporta foto sin cierre | Resolver inicializador y fila43b1c0e2, cap+4b70=7 y exposición0 | Rama relacionada con reproceso; CAIF evento12 no tiene semántica física demostrada |
+| H5 | Clases1/2/3/6 de S49 equivalen a clases de obturación | Seguir quién consume el tercer campo de las filas y discriminar dominios | 437da100 selecciona clases según bloques de servicio450/460/470/490, no selector+9 de IMX210 |
+| H6 | Hardware impide cualquier foto electrónica completa | Evidencia de circuito/modo de sensor que excluya reset/lectura por filas completa | No hay datasheet con significado de bits; existen modos6000x4000 y EFCS pero no bastan para probar posibilidad |
+| H7 | VD/callback/finDMA prueba fin de exposición | Cerrar origen físico y asociación con fotograma | S32/S34 distinguen ventana/software, DMA y exposición |
+
+No se debe convertir falta de prueba en descarte físico. Global electrónico y electrónico por filas son objetivos distintos; el usuario requiere inicio/fin electrónicos sin cierre, no simultaneidad global.
diff --git a/sony-a6000-electronic-shutter/analysis/s50/codex/S50Export.java b/sony-a6000-electronic-shutter/analysis/s50/codex/S50Export.java
new file mode 100644
index 0000000000000000000000000000000000000000..de297df36a71a32a52ad9bf41dfbaf98114c4092
--- /dev/null
+++ b/sony-a6000-electronic-shutter/analysis/s50/codex/S50Export.java
@@ -0,0 +1,59 @@
+import ghidra.app.script.GhidraScript;
+import ghidra.app.decompiler.DecompInterface;
+import com.google.gson.*;
+import java.nio.file.*;
+import java.security.MessageDigest;
+import java.util.*;
+
+/** Exporta funciones existentes sin modificar listado, referencias ni programa. */
+public class S50Export extends GhidraScript {
+    public void run() throws Exception {
+        String[] args = getScriptArgs();
+        byte[] blob = Files.readAllBytes(Path.of("analysis/rea-independent/input/av-cam.bin"));
+        String sha = HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(blob));
+        if (!sha.equals("b60c845ccb90c0ff86b7f62f1f3f2ecda714aa20c37805959ebee2b429e56bb9")) {
+            throw new Exception("Firmware SHA mismatch");
+        }
+        byte[] loaded = new byte[blob.length];
+        currentProgram.getMemory().getBytes(toAddr(0x43541000L), loaded);
+        if (!Arrays.equals(blob, loaded)) throw new Exception("Loaded bytes mismatch");
+        JsonObject root = new JsonObject();
+        root.addProperty("sha256", sha);
+        JsonArray rows = new JsonArray();
+        DecompInterface dec = new DecompInterface();
+        dec.openProgram(currentProgram);
+        try {
+            for (int i = 1; i < args.length; i++) {
+                long addr = Long.decode(args[i]);
+                var a = toAddr(addr);
+                var f = getFunctionContaining(a);
+                JsonObject row = new JsonObject();
+                row.addProperty("query", Long.toHexString(addr));
+                byte[] bytes = new byte[64];
+                currentProgram.getMemory().getBytes(a, bytes);
+                row.addProperty("raw64", HexFormat.of().formatHex(bytes));
+                JsonArray refs = new JsonArray();
+                for (var r : getReferencesTo(a)) refs.add(r.toString());
+                row.add("references", refs);
+                JsonArray listing = new JsonArray();
+                if (f != null) {
+                    row.addProperty("entry", f.getEntryPoint().toString());
+                    var result = dec.decompileFunction(f, 90, monitor);
+                    row.addProperty("completed", result.decompileCompleted());
+                    if (result.getDecompiledFunction() != null) {
+                        row.addProperty("pseudo_code", result.getDecompiledFunction().getC());
+                    }
+                    var it = currentProgram.getListing().getInstructions(f.getBody(), true);
+                    while (it.hasNext()) {
+                        var ins = it.next();
+                        listing.add(ins.getAddress() + " " + ins);
+                    }
+                } else row.addProperty("status", "no_existing_function");
+                row.add("listing", listing);
+                rows.add(row);
+            }
+        } finally { dec.dispose(); }
+        root.add("functions", rows);
+        Files.writeString(Path.of(args[0]), new GsonBuilder().setPrettyPrinting().create().toJson(root));
+    }
+}
diff --git a/sony-a6000-electronic-shutter/analysis/s50/codex/audit.py b/sony-a6000-electronic-shutter/analysis/s50/codex/audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..519404fe74236d6fb70817d18c4facfbe316ca7f
--- /dev/null
+++ b/sony-a6000-electronic-shutter/analysis/s50/codex/audit.py
@@ -0,0 +1,135 @@
+"""Contrasta evidencia estática S50; no ejecuta instrucciones del firmware."""
+
+from __future__ import annotations
+
+import csv
+import hashlib
+import json
+import re
+import struct
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+OUT = Path(__file__).resolve().parent
+BASE = 0x43541000
+EXPECTED = "b60c845ccb90c0ff86b7f62f1f3f2ecda714aa20c37805959ebee2b429e56bb9"
+
+
+def main() -> None:
+    raw = (ROOT / "analysis/rea-independent/input/av-cam.bin").read_bytes()
+    assert hashlib.sha256(raw).hexdigest() == EXPECTED
+
+    def word(address: int) -> int:
+        return struct.unpack_from("<I", raw, address - BASE)[0]
+
+    elf_path = ROOT / "analysis/rea-independent/run/av-cam-view.elf"
+    elf = elf_path.read_bytes()
+    shoff = struct.unpack_from("<I", elf, 32)[0]
+    size, count = struct.unpack_from("<HH", elf, 46)
+    code = []
+    for index in range(count):
+        header = struct.unpack_from("<10I", elf, shoff + index * size)
+        if header[2] & 4:
+            code.append(elf[header[4] : header[4] + header[5]])
+    assert code == [raw]
+
+    checks = []
+    batch_items = []
+    for path in sorted(OUT.glob("0[1-5]-*.jsonl")):
+        for line in path.read_text().splitlines():
+            row = json.loads(line)
+            result = row.get("result", {}).get("structuredContent", {}).get("normalized_result")
+            if row["call"]["tool"] == "read_bytes" and isinstance(result, dict):
+                address = int(result["address"], 16)
+                actual = bytes.fromhex(result["bytes_hex"])
+                assert actual == raw[address - BASE : address - BASE + len(actual)]
+                checks.append({"file": path.name, "address": hex(address), "bytes": len(actual)})
+            if row["call"]["tool"] == "batch_decompile" and isinstance(result, dict):
+                for item in result["items"]:
+                    batch_items.append({
+                        "query": item["address"],
+                        "status": item["status"],
+                        "canonical": item.get("procedure", {}).get("address"),
+                    })
+
+    historical = json.loads((OUT / "06-historical.json").read_text())
+    assert historical["sha256"] == EXPECTED
+    for function in historical["functions"]:
+        address = int(function["query"], 16)
+        assert bytes.fromhex(function["raw64"]) == raw[address - BASE : address - BASE + 64]
+
+    ranges = {
+        "exposure-switch": (0x436D70BE, 0x436D71E8),
+        "stage-gate": (0x438C2538, 0x438C2730),
+        "stage-pic": (0x438C27BC, 0x438C2804),
+        "curtain-request": (0x438D033C, 0x438D03FC),
+        "capture-cancel": (0x437DF5D6, 0x437DF5F6),
+        "copy-field": (0x438ACC7C, 0x438ACCB4),
+        "error-flags": (0x43AE7636, 0x43AE7660),
+        "outer-selector": (0x437EABFC, 0x437EAC98),
+        "special-row": (0x43B1C0E2, 0x43B1C118),
+        "exposure-selector": (0x437EA8CC, 0x437EABF0),
+        "service-copy": (0x43AF6870, 0x43AF68A0),
+        "exposure-getter": (0x43AD9202, 0x43AD920A),
+    }
+    listings = {}
+    for label, (start, end) in ranges.items():
+        command = [
+            "llvm-objdump", "-D", "--triple=thumbv7-none-eabi", "--adjust-vma=0x43541000",
+            f"--start-address={hex(start - BASE)}", f"--stop-address={hex(end - BASE)}", str(elf_path),
+        ]
+        result = subprocess.run(command, capture_output=True, text=True, check=True)
+        assert re.search(r"^[0-9a-f]{8}:", result.stdout, re.MULTILINE), label
+        listings[label] = {"command": command, "stdout": result.stdout, "stderr": result.stderr}
+
+    table_address = 0x436D70CA
+    table = raw[table_address - BASE : table_address - BASE + 5]
+    destinations = [table_address + 2 * value for value in table]
+    assert destinations == [0x436D70D0, 0x436D70E0, 0x436D7114, 0x436D717A, 0x436D71AE]
+    pic_base = (word(0x438C27BC) + 0x438C2546) & 0xFFFFFFFF
+    diag_slot = (pic_base + word(0x438C27C0)) & 0xFFFFFFFF
+    assert (pic_base, diag_slot, word(diag_slot)) == (0x4401EEE4, 0x4402546C, 0x43E95950)
+
+    mismatches = []
+    protected = 0
+    for line in (ROOT / "analysis/s50/shared/sha256-initial.txt").read_text().splitlines():
+        if not line.strip():
+            continue
+        expected, name = line.split(None, 1)
+        path = ROOT / name.strip()
+        digest = hashlib.sha256()
+        with path.open("rb") as stream:
+            for block in iter(lambda: stream.read(1024 * 1024), b""):
+                digest.update(block)
+        protected += 1
+        if digest.hexdigest() != expected:
+            mismatches.append(name)
+    assert not mismatches, mismatches
+    metrics = list(csv.DictReader((OUT / "run/metrics.csv").open()))
+    summary = {
+        "sha256": EXPECTED, "protected_files": protected, "mismatches": mismatches,
+        "rea_byte_reads": checks, "batch_items": batch_items,
+        "historical_functions": [
+            {key: row.get(key) for key in ["query", "entry", "completed", "status"]}
+            for row in historical["functions"]
+        ],
+        "tbb_destinations": [hex(value) for value in destinations],
+        "stage_diag": {"pic": hex(pic_base), "slot": hex(diag_slot), "object": hex(word(diag_slot))},
+        "metrics": {
+            "samples": len(metrics), "start_ts": metrics[0]["ts"], "last_ts": metrics[-1]["ts"],
+            "peak_rss_mb": max(int(row["rss_mb"]) for row in metrics),
+            "min_available_mb": min(int(row["mem_available_mb"]) for row in metrics),
+        },
+    }
+    (OUT / "llvm-evidence.json").write_text(json.dumps(listings, indent=2) + "\n")
+    (OUT / "audit-result.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps({
+        "result": "PASS", "protected_files": protected, "rea_byte_reads": len(checks),
+        "historical_functions": len(historical["functions"]), "llvm_ranges": len(listings),
+        "metrics": summary["metrics"],
+    }))
+
+
+if __name__ == "__main__":
+    main()
