index 0000000000000000000000000000000000000000..b43fb6f94feb28314e53b5b9bb2e6510277fca7c
--- /dev/null
+++ b/sony-a6000-electronic-shutter/analysis/s50/codex/01-exposure.json
@@ -0,0 +1,8 @@
+[
+  {"tool":"batch_decompile","args":{"addresses":["0x43842158","0x437eabfc","0x437ea8cc","0x436d6320","0x436d6f6c","0x438c828c","0x438c2538","0x43b1b0c8","0x4379d2ec","0x437da100"]}},
+  {"tool":"read_function_instructions","args":{"procedure":"0x436d6f6c"}},
