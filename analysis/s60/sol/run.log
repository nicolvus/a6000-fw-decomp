diff --git a/analysis/s60/sol/trace_payload.py b/analysis/s60/sol/trace_payload.py
new file mode 100644
index 0000000000000000000000000000000000000000..81a195b580de11c11b2dc948b74c7b2dbf29f828
--- /dev/null
+++ b/analysis/s60/sol/trace_payload.py
@@ -0,0 +1,113 @@
+"""S60: recorrido offline de los dos mensajes de temporización, con bytes reales."""
+import hashlib
+import json
+import struct
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[3]
+sys.path.insert(0, str(ROOT / "analysis/s58"))
+from tdis import B, data  # noqa: E402
+from wtrace import W  # noqa: E402
+from unicorn.arm_const import UC_ARM_REG_R1, UC_ARM_REG_R2  # noqa: E402
+
+SHA = "b60c845ccb90c0ff86b7f62f1f3f2ecda714aa20c37805959ebee2b429e56bb9"
+OBJ = 0x45400000
+DST = 0x45500000
+MEMCPY = [(0x43B7F878, 0x43B7F880), (0x439C5320, 0x439C5A04)]
+
+
+def case_targets():
+    blob = data("A6000")
+    table = 0x43806A08
+    return {i: 0x43806A04 + 2 * struct.unpack_from("<H", blob, table - B + i * 2)[0]
+            for i in range(12)}
+
+
+def stage_state_one():
+    """Ejecuta publicación original: imagen inicial inyectada, no captura real."""
+    w = W(ambito=[(0x43B00DD4, 0x43B00E40), (0x43B00D94, 0x43B00DD4)] + MEMCPY)
+    w.u.mem_write(OBJ, bytes(0xF00))
+    before = bytes(range(80))
+    next_value = bytes((i + 80) % 256 for i in range(80))
+    w.u.mem_write(OBJ + 0xD64, before)
+    w.u.mem_write(OBJ + 0xE04, next_value)
+    w.u.mem_write(OBJ + 0x57C, b"\x01")
+    w.w32(OBJ + 0x568, 1)
+    w.call(0x43B00DD4, OBJ)
+    return w, before, next_value
+
+
+def emit(w, address):
+    """Ejecuta constructor original y captura el argumento antes del servicio OSAL."""
+    sent = []
+
+    def capture(machine):
+        pointer = machine.u.reg_read(UC_ARM_REG_R1)
+        size = machine.u.reg_read(UC_ARM_REG_R2)
+        sent.append((pointer, machine.rd(pointer, size)))
+        return 1
+
+    w.stubfn[0x43806400] = capture
+    w.ambito += [(0x43B00CB4, 0x43B00CBA), (address, address + 0x42)]
+    w.call(address, OBJ)
+    if len(sent) != 1:
+        raise AssertionError(f"envíos observados: {len(sent)}")
+    return sent[0]
+
+
+def receiver_copy(payload, offset):
+    w = W(ambito=[(0x43B00D94, 0x43B00DA0)] + MEMCPY)
+    w.u.mem_write(DST, bytes(0xF00))
+    source = 0x45600000
+    w.u.mem_write(source, payload)
+    w.call(0x43B00D94, DST, source + offset)
+    return w.rd(DST + 0xD64, 80), w.stubbed
+
+
+def publish_state_two(value):
+    w = W(ambito=[(0x43B00DD4, 0x43B00E40), (0x43B00D94, 0x43B00DD4)] + MEMCPY)
+    w.u.mem_write(DST, bytes(0xF00))
+    w.u.mem_write(DST + 0xD64, value)
+    w.u.mem_write(DST + 0x57C, b"\x01")
+    w.w32(DST + 0x568, 2)
+    w.call(0x43B00DD4, DST)
+    return w.rd(DST + 0xDD0, 24), w.stubbed
+
+
+def probe():
+    actual = hashlib.sha256(data("A6000")).hexdigest()
+    if actual != SHA:
+        raise ValueError(f"SHA inesperado: {actual}")
+    targets = case_targets()
+    w, before, next_value = stage_state_one()
+    case4_ptr, case4 = emit(w, 0x43B00FE6)
+    case10_ptr, case10 = emit(w, 0x43B00F62)
+    copy4, stub4 = receiver_copy(case4, 4)
+    copy10, stub10 = receiver_copy(case10, 0x590)
+    published4, stubpub4 = publish_state_two(copy4)
+    published10, stubpub10 = publish_state_two(copy10)
+    return {
+        "sha256": actual,
+        "case_targets": {str(k): hex(v) for k, v in targets.items()},
+        "injected_source": before.hex(),
+        "injected_next": next_value.hex(),
+        "published_dd0": w.rd(OBJ + 0xDD0, 24).hex(),
+        "staged_d64": w.rd(OBJ + 0xD64, 80).hex(),
+        "staged_c50": w.rd(OBJ + 0xC50, 80).hex(),
+        "case4": {"pointer": hex(case4_ptr), "size": len(case4), "type": case4[0],
+                  "payload_4": case4[4:84].hex(), "payload_20": case4[0x20:0x38].hex()},
+        "case10": {"pointer": hex(case10_ptr), "size": len(case10), "type": case10[0],
+                   "payload_590": case10[0x590:0x5E0].hex(),
+                   "payload_5ac": case10[0x5AC:0x5C4].hex()},
+        "receiver_4": copy4.hex(), "receiver_10": copy10.hex(),
+        "published_4_dd0": published4.hex(), "published_10_dd0": published10.hex(),
+        "stubbed": {hex(k): v for k, v in w.stubbed.items()},
+        "receiver_stubs": [stub4, stub10, stubpub4, stubpub10],
+        "input_kind": "sintético",
+        "reachability": "NO VERIFICADO",
+    }
+
+
+if __name__ == "__main__":
+    print(json.dumps(probe(), indent=2))
diff --git a/docs/capture/s60-sol.md b/docs/capture/s60-sol.md
new file mode 100644
index 0000000000000000000000000000000000000000..23f3f9a5c02165a5169b0792ba68274f205b9206
--- /dev/null
+++ b/docs/capture/s60-sol.md
@@ -0,0 +1,79 @@
+# S60 Sol — emisor de los parámetros temporales IMX210
+
+20-10-2026. A6000 `av-cam.bin`, base `0x43541000`, SHA-256
+`b60c845ccb90c0ff86b7f62f1f3f2ecda714aa20c37805959ebee2b429e56bb9`.
+Solo instrucciones, Capstone y Unicorn offline. Los marcadores de la emulación son
+**sintéticos**. No hubo cámara, flasheo ni parche.
+
+## Resultado
+
+**VERIFICADO:** el emisor inmediato del caso 4 es `0x43b00fe6` (rol 1,
+`obj+0xd60`, 0x54 B); el del caso 10 largo es `0x43b00f62` (rol 1,
+`obj+0x6c0`, 0x5e0 B). Ambos pasan por `0x43806400` a la cola
+`0x8003030f`. El receptor `0x43806e38` espera en `0x3030f`, llama a
+`0x438069f0` en `0x43806e54` y libera el mensaje. El bit 31 entre IDs
+**no está resuelto**: por ello el vínculo entre envío y recepción es
+**PARCIAL**, aunque constructores y consumidores locales sí están probados.
+
+**VERIFICADO en el objeto del emisor, bajo la guarda de publicación:**
+`0x43b00dd4` copia primero `obj+d64 → obj+db4` (80 B), luego, si
+`obj+568=1`, reemplaza `obj+d64 ← obj+e04` (80 B) y copia
+`obj+d60 → obj+c4c` (0x54 B). Así, los mensajes posteriores transportan
+el valor de `obj+e04`: caso 4 en `payload+4`; caso 10 largo en
+`payload+0x590`. El escritor último de los **valores efectivos de**
+`obj+e04` no quedó localizado. El constructor `0x43b00b48` lo pone a cero;
+el ensayo con 80 bytes inyectados no demuestra que exista una toma con esos
+valores.
+
+## Evidencia y clasificación
+
+En todos los renglones, binario y SHA son los de la cabecera. La prueba
+reproducible es `python3 -m unittest tests.test_s60_sol -v`; el detalle de
+instrucciones está en `analysis/s60/sol/{dispatcher,payload-manager,queue-send,tv-source}.asm`
+y los resultados de ejecución en `probe-results.json`.
+
+| ID | Estado / confianza | Dirección, evidencia y resultado | Método y límite |
+|---|---|---|---|
+| S60-01 | VERIFICADO / alta | `0x43806e38..5c`: recibe ID `0x3030f`, despacha en `0x43806e54` y libera. Tabla TBH `0x43806a04`: caso 4→`0x43806c24`, caso 10→`0x43806d02`. | Capstone, bytes TBH y `test_binary_and_dispatch_targets`. No prueba entrega desde el emisor remoto. |
+| S60-02 | VERIFICADO / alta | `0x43806c58..68`: caso 4 y rol `obj+568=2` llama `0x43b00d94(obj,payload+4)`; 80 B terminan en `obj+d64`. | Instrucciones y ejecución del helper original `test_case_four_payload_and_receiver`; se inyectó mensaje. |
+| S60-03 | VERIFICADO / alta | `0x43806d24..70`: caso 10 y rol 2 copia 0x560 B desde `payload+8` a `obj+8`, 28 B desde `payload+0x570` a `obj+0x698`, y 80 B desde `payload+0x590` a `obj+d64`; responde con `0x43806590`. | Bytes/Capstone; helper final ejecutado en `test_case_ten_payload_and_receiver`. El despachador completo y OSAL no se emularon. |
+| S60-04 | VERIFICADO / alta | `0x43b00fe6..0x43b01024`: con rol 1 prepara tipo 4 en `obj+d60`, longitud 0x54; `0x43b00f62..a2`: rol 1 prepara tipo 10 en `obj+6c0`, longitud 0x5e0. Ambos llaman `0x43806400`; `0x43806408/4a/58`: destino `0x8003030f`, procedencia `0x3030f`, memcpy original y envío OSAL indirecto. | Capstone y Unicorn con interceptación **solo** del servicio OSAL; `test_case_four_payload_and_receiver`, `test_case_ten_payload_and_receiver`. ID de retorno y entrega real no demostrados. |
+| S60-05 | VERIFICADO / alta para offsets | `payload+0x20 = (payload+4)+0x1c`; `payload+0x5ac = (payload+0x590)+0x1c`. Esos 24 B llegan a `obj+dd0..de7` si se ejecuta la publicación rol 2. En el emisor largo, `obj+6c0+0x590 = obj+c50`. | Aritmética de direcciones, bytes y Unicorn (`published_4_dd0`, `published_10_dd0`). Los 24 B no son por sí mismos duración física. |
+| S60-06 | VERIFICADO / alta para el orden; PARCIAL / media para origen último | `0x43b00dd4..0x43b00e1a`, rol 1: `d64→db4` antes de `e04→d64` y `d60→c4c`. Constructor `0x43b00c3e..48` borra `e04..e53`. Emisión posterior: caso 4 usa `d64`; caso 10 usa `c50`, ambos derivados de `e04` en ese orden. | Unicorn `test_publish_then_stage_next_value`, marcadores distintos y sin stubs internos. No se identificó productor efectivo de `e04` ni se probó orden de eventos en cámara. |
+| S60-07 | PARCIAL / media | `0x43792f54..80` invoca la publicación en la ruta VD cuando `obj+57c≠0`; `0x43b00da0` copia 80 B a `obj+db4`, cuyo interior `+dd0` lee `0x43ae84c0`/`0x437aa65c`. El rol 1/2 selecciona las copias posteriores. | Bytes S59 confirmados con Unicorn S60 para ambos mensajes. La publicación es estado/configuración, no evento eléctrico ni confirmación mecánica. |
+| S60-08 | PARCIAL / media | Tv tiene una procedencia **separada** de M: `0x4383dfb6..0x4383e01a` toma cuatro u16 de `AEOUT3+0xfc+2i`, salvo ruta condicional que usa `input+0x164`; convierte con `0x4382fa94` y pasa el resultado a `0x4383d4d0`. Antes `0x4383def4/df16` selecciona/copias bancos mediante `0x4383d3c0`. | Capstone `tv-source.asm` y revisión del flujo S58. Queda sin demostrar el escritor original de los Tv y qué rama ocurre en foto 0x0b/0x2f. |
+| S60-09 | NO VERIFICADO / baja | `P+0x4c0 → X+0x5c` en `0x4383d18c`; `0x43844a2a` y `0x438451be` copian **desde `+0x4c4`**, por lo que no identifican escritor de `P+0x4c0`. `0x43866cfc` escribe un `+0x4c0` de otro objeto (`0x43eb121c`), no del P AE `0x43eaee84`. | Bytes y corrección S59-G4. Fuente, unidad y valores alcanzables de clk siguen abiertos; `0xde3` es fallback de software, no reloj medido. |
+| S60-10 | PARCIAL / media | N: `0x437aa65c` copia `(*param_2)+a8 → X8+3c` y `0x43843e94` a `P+22c`. svr: byte consumido de `M+16`, procedente del u16 `X8+14e` con truncamiento. VdNum: `0x437aab3c..52` da `max(0,raw−0x3000)` hasta `0xcfff` local, luego el productor puede verlo como signed16; el host trata N=0, estado 9 y bit15 (`0x438110be..12a`). | Instrucciones y pruebas S59, sin repetir campañas S58/S59. No hay dominio conjunto por modo; nunca se debe tomar un valor sintético como alcanzable. |
+| S60-11 | NO VERIFICADO / baja | Para modos fotográficos `0x0b` y `0x2f` no hay aquí traza de una toma que vincule simultáneamente `(M,Tv,clk,N,svr,VdNum,flags)` con el envío ni con el bus IMX210. Los emisores locales se guardan por rol, no por esos dos números de modo. | Revisión de `0x43b00fe6`/`0x43b00f62` y `0x438069f0`. No descarta guardas aguas arriba; estados sintéticos de `probe-results.json` quedan fuera del conjunto demostrado alcanzable. |
+
+## Qué se puede afirmar del estado temporal
+
+El ensayo ejecuta el código original de publicación, preparación y copia de
+los dos mensajes. Para separar valores, inyecta una secuencia en `obj+d64` y
+otra en `obj+e04`; comprueba que `obj+dd0` recibe primero la secuencia antigua
+en rol 1, mientras ambos mensajes transportan la nueva, y que una publicación
+posterior en rol 2 expone esta última en `obj+dd0`. Es una prueba de orden y
+alias de memoria. No establece que los dos roles participen de la misma toma
+ni que OSAL enrute `0x8003030f` hacia `0x3030f`.
+
+**Estados alcanzables:** solo está demostrada la existencia de rutas de código
+condicionadas por rol 1/2 y por `obj+57c`; el conjunto de tuplas temporales
+efectivas para 0x0b o 0x2f sigue **NO VERIFICADO**. Una duración calculada o
+copiada no acredita inicio ni fin de integración. Tampoco se deduce un evento
+eléctrico del IMX210, una respuesta del host ni movimiento/supresión de la
+segunda cortina. Fin electrónico de integración: **NO VERIFICADO**. S51 queda
+**A=NO, B=NO, C=NO**.
+
+## Reproducción
+
+```sh
+PYTHONDONTWRITEBYTECODE=1 python3 analysis/s60/sol/trace_payload.py
+PYTHONDONTWRITEBYTECODE=1 python3 -m unittest tests.test_s60_sol -v
+```
+
+Ejecución de esta sesión: **5 tests, OK** (`analysis/s60/sol/tests-run.log`),
+sonda en `probe-results.json`. El servicio de envío OSAL se intercepta;
+las funciones de copia y construcción internas se ejecutan sin stubs.
+
+No se editaron firmware, Ghidra, informes anteriores ni archivos ajenos a los
+entregables; no hubo `git add`, commit ni push.
diff --git a/tests/test_s60_sol.py b/tests/test_s60_sol.py
new file mode 100644
index 0000000000000000000000000000000000000000..931ff47cc99bd5a132f47175d81997aa3f36b551
--- /dev/null
+++ b/tests/test_s60_sol.py
@@ -0,0 +1,53 @@
+"""S60: comprueba bytes y ejecución offline del transporte de temporización."""
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "analysis/s60/sol"))
+import trace_payload  # noqa: E402
+
+
+class PayloadTransport(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.result = trace_payload.probe()
+
+    def test_binary_and_dispatch_targets(self):
+        self.assertEqual(self.result["sha256"], trace_payload.SHA)
+        self.assertEqual(self.result["case_targets"]["4"], "0x43806c24")
+        self.assertEqual(self.result["case_targets"]["10"], "0x43806d02")
+
+    def test_publish_then_stage_next_value(self):
+        result = self.result
+        self.assertEqual(result["published_dd0"], result["injected_source"][0x1C * 2:0x34 * 2])
+        self.assertEqual(result["staged_d64"], result["injected_next"])
+        self.assertEqual(result["staged_c50"], result["injected_next"])
+
+    def test_case_four_payload_and_receiver(self):
+        result = self.result
+        self.assertEqual(result["case4"]["pointer"], hex(trace_payload.OBJ + 0xD60))
+        self.assertEqual(result["case4"]["size"], 0x54)
+        self.assertEqual(result["case4"]["type"], 4)
+        self.assertEqual(result["case4"]["payload_4"], result["receiver_4"])
+        self.assertEqual(result["case4"]["payload_20"], result["injected_next"][0x1C * 2:0x34 * 2])
+        self.assertEqual(result["published_4_dd0"], result["case4"]["payload_20"])
+
+    def test_case_ten_payload_and_receiver(self):
+        result = self.result
+        self.assertEqual(result["case10"]["pointer"], hex(trace_payload.OBJ + 0x6C0))
+        self.assertEqual(result["case10"]["size"], 0x5E0)
+        self.assertEqual(result["case10"]["type"], 10)
+        self.assertEqual(result["case10"]["payload_590"], result["receiver_10"])
+        self.assertEqual(result["case10"]["payload_5ac"], result["injected_next"][0x1C * 2:0x34 * 2])
+        self.assertEqual(result["published_10_dd0"], result["case10"]["payload_5ac"])
+
+    def test_no_unexpected_stubs_and_synthetic_label(self):
+        self.assertEqual(self.result["stubbed"], {})
+        self.assertEqual(self.result["receiver_stubs"], [{}, {}, {}, {}])
+        self.assertEqual(self.result["input_kind"], "sintético")
+        self.assertEqual(self.result["reachability"], "NO VERIFICADO")
+
+
+if __name__ == "__main__":
+    unittest.main()

