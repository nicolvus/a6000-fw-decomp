+        self.assertEqual(result["case10"]["payload_5ac"], result["injected_next"][0x1C * 2:0x34 * 2])
+        self.assertEqual(result["published_10_dd0"], result["case10"]["payload_5ac"])
+
+    def test_no_unexpected_stubs_and_synthetic_label(self):
