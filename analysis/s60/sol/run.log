+    return w, before, next_value
+
+
+def emit(w, address):
+    """Ejecuta constructor original y captura el argumento antes del servicio OSAL."""
+    sent = []
+
+    def capture(machine):
+        pointer = machine.u.reg_read(UC_ARM_REG_R1)
+        size = machine.u.reg_read(UC_ARM_REG_R2)
