+    {"classification":"NO_VERIFICADO","file":"libObj.so, libScalarDaemon.so, libInfraStreamingServer.so","address":"N/A","method":"strings -a and dynamic-symbol/import inspection","claim":"No ashmem reference or ashmem API call was found in the examined user-space libraries."},
