+    {"classification":"INFERENCIA","file":"libInfraStreamingServer.so","address":"0x14568..0x14658","method":"control-flow and cleanup inspection","claim":"The mapped DMM unit is loaned to ISS until explicit release; final ownership/refcount is not recovered."}
+  ],
