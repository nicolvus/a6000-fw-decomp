@@ -0,0 +1,20 @@
+{
+  "session": 19,
+  "run_number": 6,
+  "task_id": "S19-06",
+  "firmware": "A6000 fw 3.21",
+  "method": "static read-only llvm-objdump --triple=thumbv7-linux-gnueabi; llvm-nm -D; llvm-readelf -rW; strings",
+  "findings": [
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x71f7b8", "finding": "MprIf::SetCallbackFunc(mediaId, fn, targetId, context) passes its reordered arguments to FEA at 0x450418."},
+    {"classification": "VERIFICADO", "file": "libmprctrl.so", "address": "0x11b96", "finding": "MprCtrl::Init registers the legacy MprIf callback after MprIf::Init."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x4502e8", "finding": "MprIfCallbackPoint invokes the resolved callback, then notifies IDs in inclusive range 0xc0000001..0xc0000091."},
+    {"classification": "VERIFICADO", "file": "libmprctrl.so", "address": "0x1c88a", "finding": "EventSwitcher filters callback entries by targetId and eventId and invokes matching entries."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x44f834", "finding": "EncodeStill reserves a slot, copies 0x40-byte RegionInfo descriptor, queues through vtable+0x20, and returns without waiting."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x44f850", "finding": "Slot exhaustion reports and returns immediate error 9."},
+    {"classification": "INFERENCIA", "file": "libmpr.so/libObj.so", "address": "0x759748 / strings", "finding": "0xc0000004 is the likely CBID_ENCODE_STILL because the literal and StillConverter callback names coexist, but no direct name-to-value code edge was found."},
+    {"classification": "NO_VERIFICADO", "file": "libObj.so", "address": "unresolved AddCallbackFunc caller", "finding": "StillConverter's actual callback-table entry, receiver object, and handler invocation were not statically recovered."},
+    {"classification": "NO_VERIFICADO", "file": "libmpr.so/libObj.so", "address": "unresolved", "finding": "Final pixel read, asynchronous cancellation semantics, and source/copy memory release are not proven."},
+    {"classification": "DESCARTADO", "file": "libmpr.so", "address": "0x44f8da", "finding": "Treating EncodeStill return 0 as encoding completion or pixel-read completion is contradicted by the immediate asynchronous return."}
+  ],
+  "safety": "No original firmware binary modified; no Ghidra project changed; no camera connected or flashed; SilentShutter is not declared functional."
+}
