  71cefa: af00         	add	r7, sp, #0x0
  71cefc: 2100         	movs	r1, #0x0
  71cefe: 4804         	ldr	r0, [pc, #0x10]         @ 0x71cf10 <_ZN5MprIf17ReleaseMemSubAreaEm+0x1c>
  71cf00: f601 e1ca    	blx	0x11e298 <_ZN8MprIfLog12AsyncApiCallEmt@plt> @ imm = #-0x5fec6c
  71cf04: 6828         	ldr	r0, [r5]
  71cf06: 4621         	mov	r1, r4
  71cf08: e8bd 40b0    	pop.w	{r4, r5, r7, lr}
