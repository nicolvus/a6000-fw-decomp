+    {"state": "VERIFICADO", "address": "0x1761a8..0x176272", "file": "libObj.so", "method": "llvm-objdump", "finding": "Constructor initializes output descriptor fields and stores a 0x2001/0x1003 PlayData message at +0xd0."},
+    {"state": "INFERENCIA", "address": "0x15fd50", "file": "libObj.so", "method": "strings plus layout and llvm-objdump", "finding": "Candidate BeginExecCommand for SequencePinDeliverExecWriteStillCmd; exact virtual-slot name remains unresolved."},
+    {"state": "VERIFICADO", "address": "0x15fd96..0x15fe88", "file": "libObj.so", "method": "llvm-objdump", "finding": "Requires non-null holder +0x14, interface +0x8 and nonzero virtual selector 12, then selector 3 and infrastructure connection; no unitType comparison occurs in this method."},
+    {"state": "VERIFICADO", "address": "0x15f290..0x15f352", "file": "libObj.so", "method": "llvm-objdump", "finding": "Local DataflowInfra endpoints are connected through infraConnectPin; no Camera object or Camera descriptor is identified."},
+    {"state": "VERIFICADO", "address": "0x15fa74..0x15fc94", "file": "libObj.so", "method": "llvm-objdump", "finding": "PbCap path allocates own DMM raster/SDS outputs, prepares descriptors and submits ObjMsg(0x3900,0x3000)."},
+    {"state": "VERIFICADO", "address": "0x15f9a0..0x15fa58", "file": "libObj.so", "method": "llvm-objdump", "finding": "SDF command endpoint is derived from holder CID and command conversion; input YC source remains undecoded."},
+    {"state": "VERIFICADO", "address": "0x15ebfc..0x15f126", "file": "libObj.so", "method": "llvm-objdump", "finding": "Only result 0x111 publishes output PlayData with raster/SDS, geometry, colorimetry and Y-range."},
+    {"state": "VERIFICADO", "address": "0x15f634..0x15f79c", "file": "libObj.so", "method": "llvm-objdump", "finding": "Completion cleanup disconnects DataflowInfra and closes normal-output DMM units; this does not establish Camera source ownership."},
+    {"state": "VERIFICADO", "address": "0x15fac8; 0x15fb1e", "file": "libObj.so plus analysis/dmm-extent-sizes.json", "method": "llvm-objdump plus prior DMM extent extraction", "finding": "Normal outputs are raster 0x50b3f/0xed/0x3fc000 and SDS 0xe0b00/0xe4/0x800; SDS is metadata, not pixels."},
+    {"state": "NO_VERIFICADO", "address": "Camera.out0 -> Effect.in0 -> holder/SDF", "file": "libObj.so", "method": "static analysis boundary", "finding": "No execution edge, holder identity, Dataflow pin identity, Camera DMM contract, source descriptor or end-to-end lifetime was recovered."},
+    {"state": "DESCARTADO", "address": "0x15fd50", "file": "libObj.so", "method": "whole-route comparison", "finding": "No unitType check in one BeginExecCommand is insufficient to prove Camera compatibility."},
+    {"state": "HIPOTESIS", "address": "Camera.out0 -> Effect.in0; 0x15fd50", "file": "libObj.so", "method": "conditional architecture inference", "finding": "A Camera holder implementing the required selectors, pins and SDF input contract could feed the operation, but no positive static evidence establishes it."}
+  ],
