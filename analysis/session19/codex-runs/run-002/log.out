+    {"status": "VERIFICADO", "file": "libBizFw2.so", "address": "0x2bf1c", "claim": "UObjPin::Connect passes this+8, destination and viewer to MWF ObjPin::Connect PLT 0x20588."},
+    {"status": "VERIFICADO", "file": "libBizFw2.so", "address": "0x43ee4", "claim": "R_ARM_JUMP_SLOT resolves the MWF ObjPin::Connect PLT entry."},
