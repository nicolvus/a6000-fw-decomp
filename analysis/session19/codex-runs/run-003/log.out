+    {"status":"INFERENCIA","file":"libObj.so","address":"0xcc5830..0xcc584f;0x91391c;0x9178f0","claim":"The ObjId 53 endpoint is an ObjStillRecorder instance, but its numeric-id-to-constructor association was not recovered."},
+    {"status":"VERIFICADO","file":"libObj.so","address":"0x41920c..0x4192e4","claim":"The dynamic lookup creates a generic 0x30-byte placeholder through 0x446e60 only on lookup miss."},
+    {"status":"DESCARTADO","file":"libObj.so","address":"0x41920c","claim":"This routine is not a static ObjId constructor table or a concrete ObjId 53 constructor."},
+    {"status":"VERIFICADO","file":"libObj.so","address":"0xfd25a4..0xfd29bf","claim":".init_array has 263 R_ARM_RELATIVE entries and no entry in ObjStillRecorder API range; no .ctors section exists."},
+    {"status":"VERIFICADO","file":"libObj.so","address":".dynsym","claim":"No pointer to ObjStillRecorder_Create or the five ObjStillRecorder exported APIs was found in allocatable data outside their dynsym values."},
