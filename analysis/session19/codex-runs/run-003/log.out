La ruta de ciclo confirma que `0x41920c` sólo fabrica el contenedor genérico de 0x30 B cuando no encuentra una entrada: no es un constructor de ObjId. Ahora estoy acotando los 263 inicializadores ELF y las referencias al valor 53 para distinguir registro real de coincidencias numéricas.
hook: PreToolUse
hook: PreToolUse Completed
exec
/usr/bin/bash -lc "objfile=firmware/extracted/fw321/firmware.tar_unpacked/0700_part_image/dev/nflasha15_unpacked_unpacked/lib/libObj.so
python3 - <<'PY'
import struct,subprocess,re
p='firmware/extracted/fw321/firmware.tar_unpacked/0700_part_image/dev/nflasha15_unpacked_unpacked/lib/libObj.so'
out=subprocess.check_output(['readelf','-SW',p],text=True)
m=re.search(r'\\[15\\]\\s+\\.init_array\\s+\\S+\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+)\\s+([0-9a-fA-F]+)',out)
_,off,size=(int(x,16) for x in m.groups()); b=open(p,'rb').read()[off:off+size]
starts=[x&~1 for x in struct.unpack('<%dI'%(size//4),b)]
# Disassemble every initializer separately and retain only #0x35 or calls into 0x419xxx
hits=[]
for i,s in enumerate(starts):
 e=starts[i+1] if i+1<len(starts) else s+0x300
 # nearest next only applies source order which does appear sorted
 d=subprocess.run(['llvm-objdump','-d','--triple=thumbv7-linux-gnueabi',f'--start-address=0x{s:x}',f'--stop-address=0x{e:x}',p],text=True,capture_output=True).stdout
 if re.search(r'#0x35\\b|41920c|419028|4195c0',d):
  lines=[x.strip() for x in d.splitlines() if re.search(r'#0x35\\b|41920c|419028|4195c0',x)]
  hits.append((i,hex(s),lines))
print('init candidates:',len(hits))
for i,s,lines in hits:
 print(i,s,' | '.join(lines[:12]))
PY
