 for i in range(0,size-3,4):
  if struct.unpack_from('<I',b,off+i)[0] "'!= 0x35: continue
  words=[struct.unpack_from('"'<I',b,off+j)[0] for j in range(max(0,i-16),min(size,i+20),4)]
  if any(0x400000 <= (x&~1) < 0xb00000 for x in words):
   print(f'{n} 0x{va+i:08x}: '+' '.join(f'{x:08x}' for x in words))
