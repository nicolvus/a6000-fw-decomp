new file mode 100644
index 0000000000000000000000000000000000000000..fa43ca1387750002a7b41125dd9950e5154fb542
--- /dev/null
+++ b/analysis/session19/evidence/mechanical-shutter-decision-points.json
@@ -0,0 +1,74 @@
+{
+  "task_id": "S19-12",
+  "scope": "Sony A6000 FW 3.21; static local LIRO analysis; av-cam.bin base 0x43541000",
+  "status": "PARTIAL",
+  "method": "llvm-objdump -d --triple=thumbv7-none-eabi on analysis/av-cam-analysis-view.elf",
+  "findings": [
+    {
+      "classification": "VERIFICADO",
