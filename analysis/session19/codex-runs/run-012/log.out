+        "CaptureStart 0x437df640 dispatches capture classes from cfg+0x265",
+        "CaptureManager 0x437df338 installs the descriptor selected by 0x437eabfc before executing 0x43b04730",
+        "EFCS bank+0x41c contributes to exposure-class selection"
+      ],
+      "inference": [
+        "A safe mechanical bypass, if one exists in this conventional chain, must be resolved at or before the descriptor execution boundary."
+      ],
+      "unverified": [
+        "0x3011/0x40193 to local 0x100 bridge",
+        "dispatcher-helper field semantics",
+        "0x437eabfc row to CAIF/Darwin mapping",
+        "a mechanical-versus-fully-electronic decision flag or active non-mechanical capture route"
+      ],
+      "discarded": [
+        "EFCS exposure class as proof of a fully electronic shutter",
+        "CaptureStart installation as proof that a curtain has moved"
+      ],
+      "next_task_id": "S19-13",
+      "safety": "Static local analysis only; no original binary or Ghidra project modified, no camera interaction or flashing; SilentShutter is not declared functional."
     }
     ]
 }
