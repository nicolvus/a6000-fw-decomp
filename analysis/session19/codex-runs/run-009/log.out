diff --git a/docs/capture/RESEARCH_TASKS.md b/docs/capture/RESEARCH_TASKS.md
index ebdf3d0aa7e7a1838bfda72a864eaaafacfe02a2..c5c10b3d34d607f2baf01723b0afd33b55f008e8
--- a/docs/capture/RESEARCH_TASKS.md
