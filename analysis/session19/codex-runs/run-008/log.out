+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x726138", "method": "llvm-objdump", "finding": "MprFileIfCore::WriteAndFlush validates handle, buffer and out-count, resets out-count, finds an MMgr, and delegates to its vtable slot +0x290."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x71eafc; 0x71eb70", "method": "llvm-objdump", "finding": "MPR exports synchronous DCF pre-registration and directory/file-number-to-EntryId lookup APIs."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "symbols and strings", "method": "llvm-nm -D; strings", "finding": "MPR exports DCF directory/content and thumbnail-playback APIs and contains the DCIM naming pattern \\DCIM\\%3ldMSDCF\\DSC0%04ld.JPG."},
