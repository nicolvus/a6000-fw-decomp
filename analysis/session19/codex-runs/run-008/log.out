+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x44f784", "method": "llvm-objdump", "finding": "FeaIf::WriteStill accepts one or two records, packages 0x90 bytes, and submits them through a virtual asynchronous interface."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x4507b6", "method": "objdump plus prior Ghidra cross-check", "finding": "The internal FeaCore WriteStill path validates state, writer availability, recording identifier, and active recording lines before queueing."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x38b064; 0x37af44", "method": "prior static disassembly cross-check", "finding": "EXIF, thumbnail, JPEG main data, reserve, and screennail are separate areas; construction checks reserve and WriteDcfMemory prefixes EXIF/thumbnail to JPEG."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x726138", "method": "llvm-objdump", "finding": "MprFileIfCore::WriteAndFlush validates handle, buffer and out-count, resets out-count, finds an MMgr, and delegates to its vtable slot +0x290."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x71eafc; 0x71eb70", "method": "llvm-objdump", "finding": "MPR exports synchronous DCF pre-registration and directory/file-number-to-EntryId lookup APIs."},
+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "symbols and strings", "method": "llvm-nm -D; strings", "finding": "MPR exports DCF directory/content and thumbnail-playback APIs and contains the DCIM naming pattern \\DCIM\\%3ldMSDCF\\DSC0%04ld.JPG."},
+    {"classification": "NO_VERIFICADO", "file": "libmpr.so", "address": "unresolved writer vtable target", "method": "static analysis", "finding": "No static edge proves that a submitted WriteStill record writes to SD, calls WriteAndFlush, invokes fsync/fdatasync, or reports durable completion."},
+    {"classification": "NO_VERIFICADO", "file": "libmpr.so/libObj.so", "address": "unresolved", "method": "static analysis", "finding": "No static edge connects WriteStill completion to DCF registration/commit/rollback, ObjMsg 0x3500/0x3002 consumption, cache invalidation, or playback visibility."},
+    {"classification": "NO_VERIFICADO", "file": "libmpr.so", "address": "unresolved", "method": "symbol and flow review", "finding": "Writer-specific cancellation, partial-file cleanup, DMM release, and error recovery semantics were not recovered."},
+    {"classification": "DESCARTADO", "file": "libmpr.so", "address": "0x44f834; strings", "method": "control-flow distinction", "finding": "EncodeStill success, a valid JPEG, or a DSC filename string is not evidence of SD write, DCF registration, or playback visibility."}
+  ],
