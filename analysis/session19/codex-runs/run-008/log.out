+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x44f784", "method": "llvm-objdump", "finding": "FeaIf::WriteStill accepts one or two records, packages 0x90 bytes, and submits them through a virtual asynchronous interface."},
