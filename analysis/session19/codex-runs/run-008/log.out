+    {"classification": "VERIFICADO", "file": "libmpr.so", "address": "0x726138", "method": "llvm-objdump", "finding": "MprFileIfCore::WriteAndFlush validates handle, buffer and out-count, resets out-count, finds an MMgr, and delegates to its vtable slot +0x290."},
