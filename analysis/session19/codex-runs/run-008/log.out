+    {"classification": "NO_VERIFICADO", "file": "libmpr.so/libObj.so", "address": "unresolved", "method": "static analysis", "finding": "No static edge connects WriteStill completion to DCF registration/commit/rollback, ObjMsg 0x3500/0x3002 consumption, cache invalidation, or playback visibility."},
+    {"classification": "NO_VERIFICADO", "file": "libmpr.so", "address": "unresolved", "method": "symbol and flow review", "finding": "Writer-specific cancellation, partial-file cleanup, DMM release, and error recovery semantics were not recovered."},
+    {"classification": "DESCARTADO", "file": "libmpr.so", "address": "0x44f834; strings", "method": "control-flow distinction", "finding": "EncodeStill success, a valid JPEG, or a DSC filename string is not evidence of SD write, DCF registration, or playback visibility."}
