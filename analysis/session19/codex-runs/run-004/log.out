@@ -0,0 +1,35 @@
+{
+  "task_id": "S19-04",
+  "verdict": "PARTIAL",
+  "scope": "Sony A6000 FW 3.21; static local analysis only; no camera interaction or binary modification.",
+  "binary": {
+    "path": "firmware/extracted/fw321/firmware.tar_unpacked/0700_part_image/dev/nflasha15_unpacked_unpacked/lib/libObj.so",
+    "sha256": "8e8a937aed23c2783e7bbee8a4afa2fb4bcd897606f190b17dccadd207d05b6a",
+    "addressing": "ELF offsets"
+  },
+  "findings": [
+    {"state": "VERIFICADO", "address": "0x959bdc..0x959bf0", "file": "libObj.so", "method": "llvm-objdump", "finding": "ObjCamera_Create allocates 0x20c and calls constructor 0x98c380."},
+    {"state": "VERIFICADO", "address": "0x98c380..0x98c4d8", "file": "libObj.so", "method": "llvm-objdump", "finding": "ObjCamera constructor initializes object state, locks, resources and helpers without calling DmmCh, DmmAccessPLA or AvbbcPhycMem."},
+    {"state": "VERIFICADO", "address": "0x987dc6..0x987fb0", "file": "libObj.so", "method": "llvm-objdump", "finding": "Nine 0x40-byte MWF ObjPin objects are constructed at this+0x58..this+0x78 with output direction."},
+    {"state": "VERIFICADO", "address": "0xcc4210 + 0x0a*0x20", "file": "libObj.so", "method": "static rodata topology decoding", "finding": "Topology 0x0a connects ObjCamera out0 to ObjEffect in0."},
+    {"state": "VERIFICADO", "address": "0x15fa74..0x15fc94", "file": "libObj.so", "method": "llvm-objdump", "finding": "ObjEffect/PbCap constructs DmmCh(0x35), calls allocNew twice, and builds ObjMsg(0x3900,0x3000); no static caller edge from ObjCamera was recovered."},
+    {"state": "VERIFICADO", "address": "0x15fac8; 0x15fb1e", "file": "libObj.so plus analysis/dmm-extent-sizes.json", "method": "llvm-objdump plus prior DMM extent extraction", "finding": "PbCap known pair: raster unitType 0x50b3f / extent 0xed / 0x3fc000; SDS unitType 0xe0b00 / extent 0xe4 / 0x800. SDS is control metadata, not pixels."},
