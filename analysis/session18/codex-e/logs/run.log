+    },
+    {
+      "status": "DESCARTADO",
+      "claim": "Las interfaces BufferArea, GetMemNonCache/ClearMemNonCache y caches de libmpr.so no son evidencia directa del buffer ObjCamera/PlayData.",
+      "evidence": ["nm -D libmpr.so: MprIfMcmd y MprIf/FeaCore", "sin enlace estatico identificado con ObjCamera, ObjEffect o StdData_YC"]
